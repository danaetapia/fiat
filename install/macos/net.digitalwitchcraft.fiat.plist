<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Launch agent: starts Fiat at login and restarts it if it stops.

  1. Replace /Users/YOU/fiat with the path to this repository.
  2. Copy this file to ~/Library/LaunchAgents/
  3. Load it:  launchctl load ~/Library/LaunchAgents/net.digitalwitchcraft.fiat.plist

  For an unattended installation, also turn on automatic login for the user
  (this requires FileVault to be off) and set a daily scheduled restart.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.digitalwitchcraft.fiat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/YOU/fiat/install/macos/start-fiat.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/fiat.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/fiat.log</string>
</dict>
</plist>
